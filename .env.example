# =============================================================================
# .env.example — PLANTILLA de variables del ecosistema Gemelo Digital.
#
# CÓMO USAR:   cp .env.example .env      (y reemplazar los valores DEMO)
# SEGURIDAD:   este archivo se VERSIONA con valores ficticios de desarrollo.
#              El archivo .env REAL está en .gitignore y NUNCA se sube al repo.
#              En producción/staging, inyectar secretos desde el gestor de
#              secrets del orquestador (K8s Secrets, ECS Secrets, Vault...).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (servicio `db`)
# -----------------------------------------------------------------------------
POSTGRES_USER=gemelo_dev
POSTGRES_PASSWORD=CAMBIO_ESTO_EN_PROD_no_versionar
POSTGRES_DB=gemelo_civil
POSTGRES_PORT=5432

# DSN que consume SQLAlchemy en el backend. Formato driver psycopg 3:
#   postgresql+psycopg://USUARIO:PASSWORD@HOST:PUERTO/BASE
# Dentro de docker-compose el host es `db` (nombre del servicio en la red);
# para correr el backend FUERA de Docker usar localhost:5432.
DATABASE_URL=postgresql+psycopg://gemelo_dev:CAMBIO_ESTO_EN_PROD_no_versionar@db:5432/gemelo_civil

# -----------------------------------------------------------------------------
# Redis (cola de vencimientos + caché efímero; servicios `redis`/`worker`)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Autenticación JWT Zero Trust (app/auth/security.py)
# -----------------------------------------------------------------------------
# SECRETO DE FIRMA HMAC-SHA256. Obligatorio: sin él la app NO arranca en
# producción (fail-fast). Generar uno nuevo por entorno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GEMELO_JWT_SECRET=REEMPLAZAR_con_token_secreto_generado_localmente
GEMELO_JWT_ALGORITHM=HS256
# Expiración CORTA por diseño (sesión judicial sensible): minutos.
GEMELO_JWT_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Aplicación / dominio
# -----------------------------------------------------------------------------
# development -> hot-reload uvicorn | production -> sin reload, fail-fast secrets
GEMELO_ENV=development
GEMELO_LOG_LEVEL=INFO
# Zona horaria de cómputo de plazos procesales (Ley 908 usa hora local NI).
TZ=America/Managua

# -----------------------------------------------------------------------------
# Puertos expuestos al host
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Frontend (build de producción de la imagen frontend/Dockerfile)
# -----------------------------------------------------------------------------
# Vacío = rutas relativas /api/* servidas por el proxy Nginx interno
# (recomendado en compose: un solo origen, sin CORS). Solo definir URL
# absoluta si el navegador apunta a un backend externo distinto.
VITE_API_URL=
